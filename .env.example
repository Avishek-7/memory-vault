# Copy this file to .env and edit as needed, then run `docker compose up`.
# See README.md's Configuration table for the full list of variables the
# server understands; this file only covers the ones worth setting for a
# local/self-hosted run via docker-compose.yml (DATABASE_URL and
# OLLAMA_URL are set directly in docker-compose.yml, not here, since they
# have to point at the other compose services).

# Bearer token(s) required on /mcp (comma-separated for multiple clients).
# Leave blank to disable auth (fine for a purely local instance).
AUTH_TOKEN=

# Comma-separated Host header allowlist, guards against DNS-rebinding.
# Leave blank to skip the check (fine for a purely local instance).
ALLOWED_HOSTS=

# Ollama models pulled by the ollama-pull compose service on first
# startup, and used at runtime for embeddings / compact_memories.
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_CHAT_MODEL=llama3.1:8b
